{
  "id": "surge",
  "version": "1.1.0",
  "platforms": [
    "ios",
    "ipados",
    "macos"
  ],
  "capabilities": [
    "dns",
    "proxy",
    "routing",
    "rules",
    "vpn"
  ],
  "required": {
    "proxy": [
      "name",
      "type",
      "server",
      "port"
    ],
    "rule": [
      "type",
      "value",
      "policy"
    ],
    "finalRule": [
      "policy"
    ]
  },
  "optional": [
    "proxy.username",
    "proxy.password",
    "proxy.tls",
    "proxy.udp",
    "dns-server",
    "fallback-dns-server",
    "policy-groups",
    "general",
    "tun"
  ],
  "unsupported": [
    "unknown-section",
    "unresolved-proxy-reference"
  ],
  "constraints": [
    "A proxy entry is defined in [Proxy] as <name> = <type>, <server>, <port>, followed by optional credentials/options.",
    "A routing rule is defined in [Rule] as TYPE,VALUE,POLICY with optional rule options.",
    "The final fallback is a FINAL rule and must define a policy.",
    "A proxy policy must resolve to a defined proxy or policy group unless it is an explicit built-in policy such as DIRECT or REJECT.",
    "Never convert a proxy policy to DIRECT without an explicit canonical fallback policy."
  ],
  "syntax": {
    "container": "INI-like text",
    "sections": [
      "[General]",
      "[Proxy]",
      "[Proxy Group]",
      "[Rule]"
    ],
    "proxyEntry": "<name> = <type>, <server>, <port>[, <username>, <password>][, <option>...]",
    "ruleEntry": "TYPE,VALUE,POLICY[,OPTION...]",
    "finalRule": "FINAL,POLICY[,OPTION...]",
    "comment": "# comment"
  },
  "validation": [
    "section-syntax",
    "proxy-entry-syntax",
    "proxy-reference-resolution",
    "server",
    "port",
    "rule-syntax",
    "final-rule",
    "dns-syntax",
    "policy-resolution"
  ],
  "output": {
    "format": "text",
    "extension": ".conf",
    "mime": "text/plain"
  },
  "artifactStatus": {
    "complete": "runnable",
    "missingRuntimeData": "template",
    "partialMapping": "partial",
    "unsupportedCapability": "rejected",
    "invalidSyntax": "invalid"
  }
}
