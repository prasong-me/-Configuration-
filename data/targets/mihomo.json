{
  "id": "mihomo",
  "version": "1.1.0",
  "platforms": [
    "android",
    "windows",
    "linux"
  ],
  "capabilities": [
    "dns",
    "proxy",
    "routing",
    "rules"
  ],
  "required": {
    "dns": [
      "dns.nameserver"
    ],
    "proxy": [
      "proxies[].name",
      "proxies[].type",
      "proxies[].server",
      "proxies[].port"
    ],
    "proxyGroup": [
      "proxy-groups[].name",
      "proxy-groups[].type",
      "proxy-groups[].proxies|use"
    ],
    "rule": [
      "rules[]"
    ]
  },
  "optional": [
    "dns.fake-ip",
    "dns.enhanced-mode",
    "proxy-providers",
    "rule-providers",
    "tun",
    "sniffer"
  ],
  "unsupported": [
    "unresolved-proxy-reference"
  ],
  "constraints": [
    "Mihomo configuration is YAML and is case-sensitive.",
    "A proxy entry uses the native name/type/server/port fields; protocol-specific fields may add further requirements.",
    "A proxy-group references proxy names or proxy-group names through proxies/use.",
    "A rule is a native comma-delimited string such as TYPE,VALUE,POLICY.",
    "A proxy policy must resolve to a defined proxy or proxy-group, except explicit built-in policies supported by the target.",
    "Do not silently map PROXY to DIRECT."
  ],
  "syntax": {
    "container": "YAML",
    "topLevelKeys": [
      "dns",
      "proxies",
      "proxy-groups",
      "proxy-providers",
      "rule-providers",
      "rules",
      "tun",
      "sniffer"
    ],
    "proxyEntry": "proxies[]: {name: <name>, type: <type>, server: <server>, port: <port>, ...}",
    "proxyGroupEntry": "proxy-groups[]: {name: <name>, type: <type>, proxies: [<name>...]|use: [<provider>...]}",
    "ruleEntry": "rules[]: TYPE,VALUE,POLICY[,OPTION...]",
    "indentation": "spaces only; tabs are invalid"
  },
  "validation": [
    "yaml-structure",
    "yaml-syntax",
    "proxy-reference-resolution",
    "proxy-groups",
    "dns-configuration",
    "rule-syntax",
    "required-fields"
  ],
  "output": {
    "format": "yaml",
    "extension": ".yaml",
    "mime": "application/yaml"
  },
  "artifactStatus": {
    "complete": "runnable",
    "missingRuntimeData": "template",
    "partialMapping": "partial",
    "unsupportedCapability": "rejected",
    "invalidSyntax": "invalid"
  }
}
