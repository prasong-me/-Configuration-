{
  "id": "loon",
  "version": "1.1.0",
  "platforms": ["ios", "ipados"],
  "capabilities": ["dns", "proxy", "routing", "rules"],
  "required": {
    "proxy": ["<name> = <type>, <server>, <port>"],
    "proxyGroup": ["<group> = <strategy>, <member>..."],
    "rule": ["<type>,<value>,<policy>"]
  },
  "optional": [
    "dns",
    "policy-groups",
    "proxy.credentials",
    "remote-resources"
  ],
  "unsupported": [
    "unresolved-proxy-reference"
  ],
  "constraints": [
    "Proxy nodes and policy groups must use Loon's native comma-delimited configuration syntax.",
    "Proxy rules must resolve to an existing proxy or policy group.",
    "Do not silently replace an unavailable proxy action with DIRECT."
  ],
  "syntax": {
    "container": "INI-like Loon configuration text",
    "proxyEntry": "<name> = <type>, <server>, <port>[, <parameter>...]",
    "proxyGroupEntry": "<group> = <strategy>, <member>...,<option>=<value>...",
    "ruleEntry": "<type>,<value>,<policy>[,<option>...]",
    "remoteResourceEntry": "<url>, policy=<policy>, tag=<tag>, enabled=<true|false>",
    "comment": "# comment"
  },
  "validation": [
    "section-syntax",
    "proxy-entry-syntax",
    "proxy-reference-resolution",
    "proxy-group-resolution",
    "dns-syntax",
    "rule-syntax",
    "resource-reference"
  ],
  "output": {
    "format": "text",
    "extension": ".lcf",
    "mime": "text/plain"
  },
  "artifactStatus": {
    "complete": "runnable",
    "missingRuntimeData": "template",
    "partialMapping": "partial",
    "unsupportedCapability": "rejected",
    "invalidSyntax": "invalid"
  }
}
