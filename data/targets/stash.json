{
  "id": "stash",
  "version": "1.0.0",
  "platforms": [
    "ios",
    "ipados"
  ],
  "capabilities": [
    "dns",
    "proxy",
    "routing",
    "rules"
  ],
  "required": {
    "dns": [
      "dns.nameserver"
    ],
    "proxy": [
      "proxy.id",
      "proxy.type",
      "proxy.server",
      "proxy.port"
    ],
    "proxyGroup": [
      "proxyGroup.id",
      "proxyGroup.members"
    ],
    "rule": [
      "rule.match",
      "rule.action"
    ]
  },
  "optional": [
    "dns.fake-ip",
    "tun",
    "sniffer",
    "proxy.credentials"
  ],
  "unsupported": [
    "unresolved-proxy-reference"
  ],
  "constraints": [
    "A proxy rule must resolve to a defined proxy or proxy group.",
    "Do not silently map PROXY to DIRECT."
  ],
  "validation": [
    "yaml-structure",
    "proxy-reference-resolution",
    "proxy-groups",
    "dns-configuration",
    "rule-syntax"
  ],
  "output": {
    "format": "yaml",
    "extension": ".yaml",
    "mime": "text/yaml"
  },
  "artifactStatus": {
    "complete": "runnable",
    "missingRuntimeData": "template",
    "partialMapping": "partial",
    "unsupportedCapability": "rejected",
    "invalidSyntax": "invalid"
  }
}
