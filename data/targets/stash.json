{
  "id": "stash",
  "version": "1.1.0",
  "platforms": [
    "ios",
    "ipados"
  ],
  "capabilities": [
    "dns",
    "proxy",
    "routing",
    "rules"
  ],
  "required": {
    "dns": [
      "dns.nameserver"
    ],
    "proxy": [
      "proxies[].name",
      "proxies[].type",
      "proxies[].server",
      "proxies[].port"
    ],
    "proxyGroup": [
      "proxy-groups[].name",
      "proxy-groups[].type",
      "proxy-groups[].proxies|use"
    ],
    "rule": [
      "rules[]"
    ]
  },
  "optional": [
    "dns.fake-ip",
    "dns.enhanced-mode",
    "proxy-providers",
    "rule-providers",
    "tun",
    "sniffer",
    "proxy.credentials"
  ],
  "unsupported": [
    "unresolved-proxy-reference"
  ],
  "constraints": [
    "Stash uses a YAML configuration structure compatible with its documented configuration model.",
    "Proxy groups reference proxy names or provider-backed proxy sets.",
    "Rules use the native comma-delimited TYPE,VALUE,POLICY syntax.",
    "A proxy rule must resolve to a defined proxy or proxy group.",
    "Do not silently map PROXY to DIRECT."
  ],
  "syntax": {
    "container": "YAML",
    "topLevelKeys": [
      "dns",
      "proxies",
      "proxy-providers",
      "proxy-groups",
      "rule-providers",
      "rules"
    ],
    "proxyEntry": "proxies[]: {name: <name>, type: <type>, server: <server>, port: <port>, ...}",
    "proxyGroupEntry": "proxy-groups[]: {name: <name>, type: <type>, proxies: [<name>...]|use: [<provider>...]}",
    "ruleEntry": "rules[]: TYPE,VALUE,POLICY[,OPTION...]",
    "indentation": "spaces only"
  },
  "validation": [
    "yaml-structure",
    "yaml-syntax",
    "proxy-reference-resolution",
    "proxy-groups",
    "dns-configuration",
    "rule-syntax",
    "required-fields"
  ],
  "output": {
    "format": "yaml",
    "extension": ".yaml",
    "mime": "application/yaml"
  },
  "artifactStatus": {
    "complete": "runnable",
    "missingRuntimeData": "template",
    "partialMapping": "partial",
    "unsupportedCapability": "rejected",
    "invalidSyntax": "invalid"
  }
}
